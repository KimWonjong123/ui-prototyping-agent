# ============================================
# LLM Provider Configuration
# ============================================

# LLM Provider: "gemini" or "ollama"
LLM_PROVIDER=gemini

# ============================================
# Gemini (Google AI) Settings
# ============================================
GEMINI_API_KEY=your-gemini-api-key-here

# Model name (default: gemini-1.5-flash for cost efficiency)
GEMINI_MODEL=gemini-1.5-flash

# ============================================
# Ollama (Local LLM) Settings
# ============================================
OLLAMA_HOST=http://localhost:11434

# Recommended models for instruction generation:
# - qwen3.5:9b (Best for Korean + code, ~9GB)
# - llama3.1:8b (Good general purpose, ~4.7GB)
# - mistral:7b (Fast, ~4.1GB)
OLLAMA_MODEL=qwen3.5:9b

# ============================================
# Data Generation Settings
# ============================================

# Number of instructions to generate per HTML component
NUM_INSTRUCTIONS_PER_COMPONENT=3

# Language for generated instructions
INSTRUCTION_LANGUAGE=ko

# Categories to extract: page, section, component (comma-separated)
EXTRACT_CATEGORIES=page,section,component

# Maximum HTML content length (characters)
MAX_HTML_LENGTH=10000

# Minimum HTML content length (characters)
MIN_HTML_LENGTH=50
